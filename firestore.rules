rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /patients/{patientId} {
      allow read, write: if isSignedIn() && isValidId(patientId);
    }

    match /recs/{recId} {
      allow read, write: if isSignedIn() && isValidId(recId);
    }

    match /scheds/{schedId} {
      allow read, write: if isSignedIn() && isValidId(schedId);
    }

    match /reports/{reportId} {
      allow read, write: if isSignedIn() && isValidId(reportId);
    }

    match /settings/{settingId} {
      allow read, write: if isSignedIn() && isValidId(settingId);
    }
  }
}
